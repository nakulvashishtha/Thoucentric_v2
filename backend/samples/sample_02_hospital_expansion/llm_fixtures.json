            "label": "Months until opening",
            "value": 24,
            "unit": "months",
            "min": 12,
            "max": 36
          },
          {
            "name": "build_months",
            "label": "Months needed to build",
            "value": 18,
            "unit": "months",
            "min": 12,
            "max": 24
          }
        ],
        "source_type": "client_goal",
        "source_note": "Open within 24 months; the building takes 18, so hiring must take 6 months or less.",
        "must_have": false,
        "recency_category": "structural_timing"
      },
      {
        "code": "H4",
        "text": "Patients can pay: at least 25% of county residents have health insurance.",
        "fact_type": "market",
        "measure_name": "Health insurance coverage",
        "measure_unit": "%",
        "measure_definition": "Share of county residents covered by any health insurance.",
        "comparator": ">=",
        "pass_line_value": 25,
        "source_type": "estimate",
