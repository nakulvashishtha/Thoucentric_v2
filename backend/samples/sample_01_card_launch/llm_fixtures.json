{
  "FRAME": {
    "client_belief": "The number of credit cards in India is growing about 30% a year.",
    "decision": "Launch a credit card within 18 months, and break even by year 3?",
    "case_measure_name": "Credit cards in use, all of India",
    "case_measure_definition": "Count of credit cards in use (cards, not cardholders) across India, as counted by the central bank."
  },
  "PLAN_HYPOTHESES": {
    "ideas": [
      {
        "code": "H1",
        "text": "The market grows fast enough: credit cards in use grow at least 20% a year.",
        "fact_type": "market",
        "measure_name": "Growth in credit cards in use",
        "measure_unit": "% a year",
        "measure_definition": "Compound annual growth in the count of credit cards in use, all of India.",
        "comparator": ">=",
        "pass_line_value": null,
        "pass_line_formula": "required_growth",
        "assumptions": [
          {
            "name": "required_growth",
            "label": "Growth the launch needs",
            "value": 20,
            "unit": "% a year",
            "min": 5,
            "max": 35
          }
        ],
        "source_type": "benchmark",
        "source_note": "New issuers win 6 to 8% of new cards; at that share the card base must grow at least 20% a year for the launch to break even by year 3.",
        "must_have": true,
        "recency_category": "size_growth_price",
        "benchmark_need": "Share of new credit cards won by new issuers in India"
      },
      {
        "code": "H2",
        "text": "The card pays for itself: the sign-up cost is paid back within 24 months.",
        "fact_type": "client_operational",
        "measure_name": "Payback on sign-up cost",
        "measure_unit": "months",
        "measure_definition": "Sign-up cost per active card divided by the monthly margin per active card.",
        "comparator": "<=",
        "pass_line_value": 24,
        "pass_line_formula": "36 - 12",
        "source_type": "client_goal",
        "source_note": "Break even by year 3 (36 months) minus 12 months of launch costs before cards earn.",
        "must_have": true,
        "recency_category": "structural_timing"
      },
      {
        "code": "H3",
        "text": "The client has an edge: existing customers are at least 30% cheaper to sign up.",
        "fact_type": "client_operational",
        "measure_name": "Sign-up cost advantage for existing customers",
        "measure_unit": "%",
        "measure_definition": "How much less it costs to sign up an existing customer than a new one, in percent.",
        "comparator": ">=",
        "pass_line_value": 30,
        "source_type": "benchmark",
        "source_note": "Banks sign up existing customers 30 to 35% more cheaply; the edge must at least match the low end.",
        "must_have": false,
        "recency_category": "size_growth_price",
        "benchmark_need": "Cost advantage banks have when signing up existing customers for a card"
      },
      {
        "code": "H4",
        "text": "Set up in time: the issuing bank and approvals are in place within 12 months.",
        "fact_type": "market",
        "measure_name": "Time to set up issuing bank and approvals",
        "measure_unit": "months",
        "measure_definition": "Months from starting set-up to having the issuing bank arrangement and approvals in place.",
        "comparator": "<=",
        "pass_line_formula": "18 - build_months",
        "assumptions": [
          {
            "name": "build_months",
            "label": "Months needed to build the product",
            "value": 6,
            "unit": "months",
            "min": 3,
            "max": 12
          }
        ],
        "source_type": "client_goal",
        "source_note": "Launch within 18 months, minus 6 months to build the product.",
        "must_have": false,
        "recency_category": "structural_timing"
      },
      {
        "code": "H5",
        "text": "How credit cards developed in India over the past 30 years.",
        "fact_type": "market",
        "measure_name": "Years since first card",
        "measure_unit": "years",
        "comparator": ">=",
        "pass_line_value": 0,
        "source_type": "estimate",
        "source_note": "Background only.",
        "must_have": false,
        "recency_category": "structural_timing"
      }
    ]
  },
  "GENERATE_QUERIES:bench:H1": {
    "queries": [
      "India new credit card issuers share of new cards 2023 to 2025"
    ]
  },
  "GENERATE_QUERIES:bench:H3": {
    "queries": [
      "bank credit card acquisition cost existing versus new customers benchmark"
    ]
  },
  "ROUTE_NEEDS": {
    "needs": [
      {
        "ref": "N1",
        "idea": "H1",
        "text": "Can Example Client Ltd reach the growth its card launch needs? Forecasts of growth in credit cards in use in India.",
        "route": "desk",
        "coverage": "not_covered"
      },
      {
        "ref": "N2",
        "idea": "H1",
        "text": "Official counts of credit cards in use in India over the last five years.",
        "route": "desk",
        "coverage": "not_covered"
      },
      {
        "ref": "N3",
        "idea": "H1",
        "text": "The client's own view of market growth.",
        "route": "client",
        "coverage": "answered_by_client_file",
        "file": "board_note.txt",
        "locator": "line 3"
      },
      {
        "ref": "N4",
        "idea": "H2",
        "text": "Sign-up cost per active card and monthly margin per active card from the client's pilot.",
        "route": "client",
        "coverage": "partly",
        "file": "acquisition_analysis.csv",
        "locator": "B5",
        "missing": "The file has the pilot's monthly margin per active card, but not the sign-up cost per active card."
      },
      {
        "ref": "N5",
        "idea": "H2",
        "text": "Typical payback period on sign-up cost for new card issuers.",
        "route": "expert",
        "coverage": "not_covered"
      },
      {
        "ref": "N6",
        "idea": "H3",
        "text": "The client's sign-up cost for existing versus new customers.",
        "route": "client",
        "coverage": "answered_by_client_file",
        "file": "acquisition_analysis.csv",
        "locator": "B4"
      },
      {
        "ref": "N7",
        "idea": "H3",
        "text": "Market evidence on the cost advantage of signing up existing customers.",
        "route": "desk",
        "coverage": "not_covered"
      },
      {
        "ref": "N8",
        "idea": "H4",
        "text": "Time for a new issuer to set up an issuing bank arrangement and approvals in India.",
        "route": "desk",
        "coverage": "not_covered"
      },
      {
        "ref": "N9",
        "idea": "H4",
        "text": "How long bank onboarding and approvals take in practice.",
        "route": "expert",
        "coverage": "not_covered"
      }
    ]
  },
  "GENERATE_QUERIES:N1": {
    "queries": [
      "India credit cards in use, annual growth forecast 2025 to 2030"
    ]
  },
  "GENERATE_QUERIES:N2": {
    "queries": [
      "India credit cards outstanding official monthly data 2019 to 2024"
    ]
  },
  "GENERATE_QUERIES:N7": {
    "queries": [
      "retail bank cost to sign up existing versus new customers for credit cards"
    ]
  },
  "GENERATE_QUERIES:N8": {
    "queries": [
      "India new credit card issuer set-up time issuing bank and approvals"
    ]
  },
