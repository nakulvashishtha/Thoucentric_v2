# Copy this file to .env and fill in the values. Never commit .env and never paste keys into chat.
# Steps 1 to 3 of the build need no keys at all.

ANTHROPIC_API_KEY=          # from the Claude Console (platform.claude.com); pay-as-you-go
TAVILY_API_KEY=             # from tavily.com; free plan includes 1,000 credits a month
ADMIN_PASSCODE=             # any passcode you choose; the whole app asks for it

# Model names: take the exact IDs from the Claude Console model list.
MODEL_FAST=                 # Haiku-class model (cheap; reads sources, routes, links)
MODEL_SMART=                # Sonnet-class model (frames, plans, drafts, summarises)

MODE=live                   # live or fixtures (the app falls back to fixtures if keys are missing)
DAILY_SPEND_CAP=5           # US dollars per day; raise it on rehearsal days
MAX_LLM_CALLS_PER_CASE=150
DATA_DIR=./data
PORT=8000
