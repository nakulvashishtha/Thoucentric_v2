        "measure_unit": "% a year",
        "measure_definition": "Yearly growth in private inpatient days, Nakuru County.",
        "comparator": ">=",
        "pass_line_value": 8,
        "source_type": "benchmark",
        "source_note": "Past openings needed at least 8% a year demand growth to fill a 150-bed hospital within three years.",
        "must_have": true,
        "recency_category": "size_growth_price",
        "benchmark_need": "Inpatient demand growth needed to fill a new hospital"
      },
      {
        "code": "H2",
