# Copy this file to .env and fill in the values. Never commit .env and never paste keys into chat.
# Without the two keys the app still opens, in demo data mode with the sample cases.

ANTHROPIC_API_KEY=                 # from the Claude Console (platform.claude.com); pay-as-you-go
TAVILY_API_KEY=                    # from tavily.com; the free plan includes 1,000 credits a month
ADMIN_PASSCODE=                    # any phrase you choose; the whole app asks for it

# Model names: exact IDs from the Claude Console model list.
MODEL_FAST=claude-haiku-4-5        # cheap model: reads sources, routes needs, writes searches, links evidence
MODEL_SMART=claude-sonnet-5-5      # better model: frames the ask, drafts ideas, follow-ups and the summary

MODE=live                          # live or fixtures (the app falls back to fixtures if keys are missing)
DAILY_SPEND_CAP=5                  # US dollars per day; raise it on rehearsal days
MAX_LLM_CALLS_PER_CASE=150         # AI calls allowed per case
MAX_SEARCH_CREDITS_PER_CASE=40     # search credits allowed per case
DATA_DIR=./data                    # where the database lives
PORT=8000                          # the hosting service sets this for you
